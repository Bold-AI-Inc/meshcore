PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://mesh_admin_role:YOUR-PASSWORD@db.your-project-ref.supabase.co:5432/postgres
GATEWAY_DATABASE_URL=postgresql://mesh_gateway_role:YOUR-PASSWORD@db.your-project-ref.supabase.co:5432/postgres
MESH_MASTER_KEY=replace-with-output-of-openssl-rand-hex-32
MESH_KEY_PEPPER=replace-with-output-of-openssl-rand-hex-32
COOKIE_SECURE=false

# --- Database -----------------------------------------------------------
# How pgx executes queries. The default, cache_describe, caches each
# statement's parameter/result description client-side while still using the
# unnamed prepared statement, so it is safe through a transaction-mode pooler
# (Supabase's PgBouncer on port 6543) AND gives Postgres real typed parameters.
#
# If you connect DIRECTLY to Postgres (port 5432, no pooler), set this to
# cache_statement for true server-side prepared statements — a further win on
# the repeated queries (telemetry writes, the logs dashboard).
#   cache_describe   (default, pooler-safe)
#   cache_statement  (fastest; direct connections only)
#   describe_exec    (pooler-safe, one extra round trip, no caching)
#   simple           (escape hatch; no typed parameters — avoid)
DB_EXEC_MODE=cache_describe

# Connection pool ceilings. The admin pool serves the dashboard and the log
# retention job; the gateway pool serves telemetry writes and the periodic
# counter checkpoints (the /v1 hot path itself does no synchronous DB work).
ADMIN_POOL_MAX_CONNS=8
GATEWAY_POOL_MAX_CONNS=16

# --- request_logs retention ---------------------------------------------
# Every request — including every denial — writes a row, and the table is not
# partitioned, so it needs a retention policy or it grows without bound. The
# job runs hourly in-process and deletes in small chunks so it stays invisible
# to live traffic. Set to 0 to disable deletion entirely (not recommended).
LOG_RETENTION_DAYS=30

# --- Snapshot reconciliation --------------------------------------------
# How often the gateway's in-RAM config snapshot is rebuilt unconditionally.
# Admin mutations rebuild it inline already; this is the backstop that bounds
# how long a failed inline rebuild can leave a revoked key working.
SNAPSHOT_RECONCILE_SECONDS=45

# --- Admission queue ----------------------------------------------------
QUEUE_CAPACITY=200
QUEUE_ADMIT_TIMEOUT_MS=4000
QUEUE_GOROUTINE_CEILING=5000
QUEUE_HEAP_CEILING_MB=1024

# --- Request/response size limits ---------------------------------------
MAX_REQUEST_BODY_MB=300
GENERATION_TIMEOUT_SECONDS=120
MAX_GENERATION_RESPONSE_MB=300

# Bounds a single upstream /v1/embeddings call. Separate from the generation
# budget above: an embeddings call returns in well under a second, where a
# video generation job legitimately takes minutes.
EMBEDDINGS_TIMEOUT_SECONDS=60

# --- Proxy awareness -----------------------------------------------------
# X-Forwarded-For is trusted ONLY when this is true. Leave it false when the
# server is reachable directly: the header is caller-supplied, so trusting it
# lets anyone forge source_ip in request_logs and evade the login rate limit.
# Set it to true only when every request arrives through a reverse proxy or
# load balancer that appends the real client address.
TRUST_PROXY_HEADER=false

# --- Metrics scraping ----------------------------------------------------
# GET /admin/metrics serves Prometheus text format. It always accepts a
# logged-in admin session cookie (that is how the dashboard reads it). Set a
# token here to ALSO accept `Authorization: Bearer <token>`, which is what a
# Prometheus scrape config can actually send. Leave it empty to keep the
# endpoint session-only.
METRICS_TOKEN=

# --- Admin roles ---------------------------------------------------------
# The single admin permitted to pause, resume and delete other admins. Every
# other admin can still create and list them.
SUPERADMIN_EMAIL=alan@experiencebold.ai
